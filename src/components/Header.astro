---
import { site, nav, waLink } from '../data/site';

const bookLink = waLink(site.whatsapp.appointments, 'Hello, I would like to book a consultation with Dr. Deepa.');
---

<header class="site-header" data-header>
  <div class="bar">
    <a href="#top" class="brand" aria-label="Transform Life Programs, back to top">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand-name">TRANSFORM<span>LIFE</span></span>
    </a>

    <nav class="inline-nav" aria-label="Primary">
      <ul role="list">
        {nav.map((l) => <li><a href={l.href} data-spy={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="bar-end">
      <a href={`tel:${site.phones.appointments.tel}`} class="ghost-btn">Call</a>
      <a href={bookLink} class="book-btn" target="_blank" rel="noopener">Book now</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu-panel" id="site-menu" data-mobile-nav hidden>
    <ul role="list">
      {nav.map((l, i) => <li style={`--mi:${i}`}><a href={l.href} data-close-menu>{l.label}</a></li>)}
    </ul>
    <div class="menu-contact">
      <a href={`tel:${site.phones.appointments.tel}`}><span>Appointments</span>{site.phones.appointments.display}</a>
      <a href={`tel:${site.phones.crystals.tel}`}><span>Crystals & classes</span>{site.phones.crystals.display}</a>
    </div>
  </div>
</header>

<script>
  // The current section's link gets the lit pill.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const sections = links.map((a) => document.querySelector<HTMLElement>(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle('active', a.dataset.spy === `#${e.target.id}`));
        }),
      { rootMargin: '-50% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
  }

  /* Always dark, so it reads over the black hero and the white sections */
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem clamp(1.25rem, 4vw, 3rem);
    color: var(--white);
    transition: background-color 0.5s, padding 0.5s var(--ease);
  }

  .site-header:global(.is-scrolled) .bar,
  .site-header:global(.menu-open) .bar {
    padding-block: 0.6rem;
    background: rgba(6, 7, 14, 0.82);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }

  @media (min-width: 1024px) {
    .bar {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      animation: bar-in 1s var(--ease-out) 1.2s both;
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }

  /* Four-petal mark, echoing a flower of life */
  .brand-mark {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .brand-mark i {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50% 50% 50% 0;
    background: var(--periwinkle);
  }

  .brand-mark i:nth-child(1) {
    top: 0;
    left: 5px;
    rotate: 135deg;
  }

  .brand-mark i:nth-child(2) {
    top: 5px;
    right: 0;
    rotate: 225deg;
    opacity: 0.7;
  }

  .brand-mark i:nth-child(3) {
    bottom: 0;
    left: 5px;
    rotate: 315deg;
  }

  .brand-mark i:nth-child(4) {
    top: 5px;
    left: 0;
    rotate: 45deg;
    opacity: 0.7;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-name span {
    font-weight: 300;
  }

  .inline-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .inline-nav {
      display: block;
    }
  }

  /* Glass pill of links */
  .inline-nav ul {
    display: flex;
    gap: 0.15rem;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .inline-nav a {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 9px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: background-color 0.3s, color 0.3s;
  }

  .inline-nav a:hover {
    color: var(--white);
  }

  .inline-nav a:global(.active) {
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: end;
  }

  .ghost-btn,
  .book-btn {
    padding: 0.45rem 0.9rem;
    border-radius: 9px;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .ghost-btn {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--white);
  }

  .ghost-btn:hover {
    border-color: var(--periwinkle);
    color: var(--periwinkle);
  }

  @media (max-width: 479px) {
    .ghost-btn {
      display: none;
    }
  }

  .book-btn {
    background: var(--white);
    color: #06070e;
  }

  .book-btn:hover {
    background: var(--periwinkle);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9px;
    background: transparent;
    color: var(--white);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .bars {
    display: grid;
    gap: 4px;
    width: 14px;
  }

  .bars i {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }

  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  .menu-panel {
    width: min(340px, calc(100% - 1.5rem));
    margin: 0.5rem clamp(0.75rem, 3vw, 2rem) 0 auto;
    padding: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    background: rgba(10, 11, 20, 0.96);
    color: var(--white);
    transform-origin: top right;
    animation: panel-in 0.45s var(--ease-out);
  }

  .menu-panel[hidden] {
    display: none;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
  }

  .menu-panel ul {
    margin: 0;
    padding: 0;
  }

  .menu-panel li a {
    display: block;
    padding: 0.65rem 0.9rem;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s, padding 0.3s var(--ease);
  }

  .menu-panel li a:hover {
    background: rgba(255, 255, 255, 0.06);
    padding-left: 1.2rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-panel:not([hidden]) li {
      animation: m-in 0.5s var(--ease-out) both;
      animation-delay: calc(var(--mi) * 40ms + 60ms);
    }
  }

  @keyframes m-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .menu-contact {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0.9rem 0.9rem 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .menu-contact a {
    display: grid;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .menu-contact span {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.55);
  }
</style>
